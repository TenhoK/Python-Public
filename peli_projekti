# PELAAJA CLASS
class Pelaaja():
    def __init__(self, nimi, esineet, sijainti):
        self.nimi = nimi
        self.esineet = esineet
        self.sijainti = sijainti
        self.energia = 100
        self.päästöt = 0

    # LISÄÄ PELAAJALLE TAVAROITA
    def LisääReppuun(self, uusiEsine):
         # JOS ENERGIA JUOMA NIIN LISÄÄ 50 ENERGIAAN
        if uusiEsine.nimi == "Energia Juoma":
            self.energia += 50
            print("")
            print(f"Energiaa lisätty! Enegiaa nyt: {self.energia}%")
        self.esineet.append(uusiEsine)

    # LIIKUTTAA UUTEEN SIJAINTIIN JA MIINUSTAA ENERGIAA JA LISÄÄ PÄÄSTÖJÄ KULKUNEUVON PERUSTEELLA
    def Liiku(self, paikka):
        self.sijainti = paikka
        self.energia -= 20
        self.päästöt += paikka.päästöt
        # JOKA LIIKKUMISEN JÄLKEEN ENERGIA PRINTATAAN
        print("")
        print(f"Energiaa jäljellä: {self.energia}%")
        # JOS PÄÄSTÖJÄ KERTYNY NIIN NE PRINTATAAN
        if self.päästöt > 0:
            print(f"Päästöjä yhteensä: {self.päästöt}g CO2")


# PAIKKA CLASS
class Paikka():
    def __init__(self, nimi, esine, seuraavatPaikat, vaatii=None, päästöt=0):
        self.nimi = nimi
        self.esine = esine
        self.seuraavatPaikat = seuraavatPaikat
        self.vaatii = vaatii
        self.päästöt = päästöt

