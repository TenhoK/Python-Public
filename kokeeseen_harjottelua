# vain YKSI haara suoritetaan!


# VERTAILUOPERAATTORIT
# ==   yhtä suuri
# !=   eri suuri
# <    pienempi kuin
# >    suurempi kuin
# <=   pienempi tai yhtä suuri
# >=   suurempi tai yhtä suuri

luku = 5
if luku == 5:
    print("Luku on viisi")   # == vertailu


# LOOGISET OPERAATTORIT: and, or, not
ikä = 20
jäsen = True

if ikä >= 18 and jäsen:
    print("Pääsee sisään")       # molempien pitää olla tosia

if ikä < 12 or ikä > 65:
    print("Alennus")             # riittää että toinen on tosi

if not jäsen:
    print("Ei ole jäsen")        # not kääntää toisin päin




