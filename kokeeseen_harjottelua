# Funktio jolla on monta parametria
def LaskeSumma(a, b):
    return a + b

print(LaskeSumma(3, 7)) # a=3, b=7 -> 10


# return ANTAA arvon takaisin, jota voi käyttää muualla!
# print TULOSTAA vain ruudulle eikä palauta mitään!
def KerroKahdella(x):
    return x * 2    # palauttaa arvon

tulos = KerroKahdella(4)    # tulos = 8, voidaan tallentaa muuttujaan
print(tulos)                # -> 8


# Funktio joka käyttää listaa parametrina
def LaskeLista(luvut):
    summa = 0
    for luku in luvut:
        summa = summa + luku
    return summa

print(LaskeLista([1, 2, 3, 4]))  # -> 10



