# IMPORT RANDOM (satunnaisuus)
import random

print(random.randint(1,6))      # kokonaisluku 1-6 (molemmat mukana)
print(random.random())          # desimaali 0.0 - 1.0
lista = ["miekka", "kilpi", "jousi"]
print(random.choice(lista))     # arpoo yhden alkion listasta
random.shuffle(lista)           # sekoittaa listan järjestyksen
print(lista)                    # tulostaa sekoitetun listan
